# Copy to .env / export in your shell (or set on Railway). Spring reads real env vars.
SPRING_PROFILES_ACTIVE=dev

# Dev uses a locally-run Postgres (see README). Port 5442 avoids clashing with a
# system Postgres on 5432.
DB_URL=jdbc:postgresql://localhost:5442/webnovel
DB_USERNAME=webnovel
DB_PASSWORD=webnovel

# JWT — secret MUST be >= 32 bytes (HS256). Generate one for prod.
APP_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
APP_JWT_ACCESS_TTL=PT15M
APP_JWT_REFRESH_TTL=P30D

# Business parameters (PROJECT SPEC.md §14)
APP_PLATFORM_FEE_PERCENT=20
APP_MIN_WITHDRAWAL_MMK=5000
APP_SUBSCRIPTION_DAYS=30

APP_CORS_ORIGINS=http://localhost:5173

# Email (Resend HTTP API). MAIL_ENABLED=true + a real key sends live mail; with a
# blank key it just logs the code to the console. MAIL_FROM must be on a domain
# verified in Resend. Get the key at https://resend.com (starts with re_...).
MAIL_ENABLED=true
MAIL_FROM=noreply@novelspire.dpdns.org
RESEND_API_KEY=
