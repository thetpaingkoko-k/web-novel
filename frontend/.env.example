# Base URL for the backend REST API, including the /api/v1 prefix.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Production (Vercel): do NOT commit the prod value here. Set VITE_API_BASE_URL
# in the Vercel project's Environment Variables to your Render backend, e.g.
#   VITE_API_BASE_URL=https://webnovel-backend.onrender.com/api/v1
# Vite reads VITE_-prefixed vars at build time; no .env.production file needed.
