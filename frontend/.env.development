# Dev defaults. `npm run dev` picks these up automatically.
# Base URL for the backend REST API (Spring Boot dev server), /api/v1 prefix included.
# Dev seed admin login: admin@webnovel.local / admin12345
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Google Sign-In: the OAuth Web client ID from Google Cloud Console. Public value
# (it ships in the client). When unset, the "Continue with Google" button is hidden.
VITE_GOOGLE_CLIENT_ID=894084339777-n1r806m03mpq7iuj2a3k8if51pm9c059.apps.googleusercontent.com
